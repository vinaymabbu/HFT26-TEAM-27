{
  "$defs": {
    "CameraImage": {
      "description": "The video frame a camera_image scene is drawn on (fetch it from /api/evidence/{id}/frames/{frame}).",
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "frame": {
          "title": "Frame",
          "type": "integer"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "views": {
          "description": "[x1, y1, x2, y2] per camera view, in px",
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Views",
          "type": "array"
        },
        "fps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Video frame rate: frame index = round((t_s - t_offset_s) * fps)",
          "title": "Fps"
        },
        "t_offset_s": {
          "default": 0.0,
          "title": "T Offset S",
          "type": "number"
        }
      },
      "required": [
        "evidence_id",
        "frame",
        "width",
        "height"
      ],
      "title": "CameraImage",
      "type": "object"
    },
    "CollisionMarker": {
      "properties": {
        "t_s": {
          "title": "T S",
          "type": "number"
        },
        "x_m": {
          "title": "X M",
          "type": "number"
        },
        "y_m": {
          "title": "Y M",
          "type": "number"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "supporting_observation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Observation Ids",
          "type": "array"
        }
      },
      "required": [
        "t_s",
        "x_m",
        "y_m",
        "confidence",
        "supporting_observation_ids"
      ],
      "title": "CollisionMarker",
      "type": "object"
    },
    "Scene": {
      "description": "four_way_intersection: metres, +x east, +y north. camera_image: pixels of `image`, +y down.\nTrackPoint.x_m / y_m are in the scene's `units`.",
      "properties": {
        "type": {
          "default": "four_way_intersection",
          "enum": [
            "four_way_intersection",
            "metric",
            "camera_image"
          ],
          "title": "Type",
          "type": "string"
        },
        "units": {
          "default": "m",
          "enum": [
            "m",
            "px",
            "schematic"
          ],
          "title": "Units",
          "type": "string"
        },
        "extent_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Intersection: half-width of the square view around the origin",
          "title": "Extent M"
        },
        "lane_width_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lane Width M"
        },
        "roads": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "axis -> road name, e.g. {'ns': 'Main Rd'}",
          "title": "Roads",
          "type": "object"
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraImage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "center_m": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "metric: centre of the view (x, y) in metres",
          "title": "Center M"
        },
        "frame_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the axes mean when not compass-aligned, e.g. a camera's road frame",
          "title": "Frame Note"
        }
      },
      "title": "Scene",
      "type": "object"
    },
    "TrackPoint": {
      "properties": {
        "t_s": {
          "title": "T S",
          "type": "number"
        },
        "x_m": {
          "description": "Scene units: metres, or pixels when scene.units == 'px'",
          "title": "X M",
          "type": "number"
        },
        "y_m": {
          "title": "Y M",
          "type": "number"
        },
        "heading_deg": {
          "title": "Heading Deg",
          "type": "number"
        },
        "speed_kmh": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speed Kmh"
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "measured",
                "interpolated",
                "extrapolated",
                "tracked",
                "estimated"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "measured: at a sensor sample; interpolated/extrapolated: between/beyond samples; tracked: from video motion tracking; estimated: no positional evidence (scene default)",
          "title": "Source"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "seen_in_video": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "True when the vehicle was actually detected in video at this moment (a motion-tracker or AI sighting), even if its position on the plan is only estimated; False/None otherwise. Separates 'it was seen' from 'where it was on the map is measured'.",
          "title": "Seen In Video"
        }
      },
      "required": [
        "t_s",
        "x_m",
        "y_m",
        "heading_deg"
      ],
      "title": "TrackPoint",
      "type": "object"
    },
    "VehicleTrack": {
      "properties": {
        "vehicle_id": {
          "title": "Vehicle Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "color": {
          "title": "Color",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "track": {
          "items": {
            "$ref": "#/$defs/TrackPoint"
          },
          "title": "Track",
          "type": "array"
        },
        "source_observation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Observation Ids",
          "type": "array"
        }
      },
      "required": [
        "vehicle_id",
        "label",
        "color",
        "track"
      ],
      "title": "VehicleTrack",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.3.3",
      "title": "Schema Version",
      "type": "string"
    },
    "incident_id": {
      "title": "Incident Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "scene": {
      "$ref": "#/$defs/Scene"
    },
    "t_min_s": {
      "title": "T Min S",
      "type": "number"
    },
    "t_max_s": {
      "title": "T Max S",
      "type": "number"
    },
    "vehicles": {
      "items": {
        "$ref": "#/$defs/VehicleTrack"
      },
      "title": "Vehicles",
      "type": "array"
    },
    "collision": {
      "anyOf": [
        {
          "$ref": "#/$defs/CollisionMarker"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Why the reconstruction is empty or limited, in plain words",
      "title": "Note"
    }
  },
  "required": [
    "incident_id",
    "generated_at",
    "scene",
    "t_min_s",
    "t_max_s",
    "vehicles"
  ],
  "title": "Reconstruction",
  "type": "object"
}
