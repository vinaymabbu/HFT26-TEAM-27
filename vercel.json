{
  "buildCommand": "npm --prefix src/frontend install && npm --prefix src/frontend run build",
  "outputDirectory": "src/frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{fixtures,data,src/frontend/dist}/**",
      "excludeFiles": "{eval,docs,tests,storage,scripts,node_modules,src/frontend/node_modules,src/frontend/src}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__p=:path*"
    }
  ]
}